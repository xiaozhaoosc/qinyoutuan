# New frontend
/frontend/node_modules/
# dist is a build artifact, but frontend/embed.go does //go:embed all:dist, which
# fails to compile if the directory is absent. Ignore its contents but keep a
# committed placeholder so `go build ./...` works on a fresh clone before a build.
/frontend/dist/*
!/frontend/dist/.gitkeep
# TypeScript incremental build cache — a build artifact, must not be tracked.
/frontend/tsconfig.tsbuildinfo
# Local SSH keys / scratch (Oracle server access). Never commit credentials.
/oracle/
